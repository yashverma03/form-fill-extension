#!/bin/sh

set -eu
trap 'code=$?; [ "$code" -ne 0 ] && echo "ERROR | line=$LINENO | exit_code=$code" >&2; exit $code' EXIT

log_dir="$(cd "$(dirname "$0")/../.." && pwd)/logs"
mkdir -p "$log_dir"
log_file="$log_dir/husky-pre-push.log"

status=0
npm run build >> "$log_file" 2>&1 || status=$?

if [ "$status" -ne 0 ]; then
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] Build failed (exit code $status)" >> "$log_file"
  exit 1
fi

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Build succeeded" >> "$log_file"
